+int gpu_present_shared(void *handle, uint32_t width, uint32_t height)
+{
+    static struct { void *h; ID3D11Texture2D *tex; IDXGIKeyedMutex *mx; } open[8];
+    static int nopen;
+    ID3D11Texture2D *tex = NULL;
+    IDXGIKeyedMutex *mx = NULL;
+    int i;
