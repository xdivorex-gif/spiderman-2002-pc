+            mutant = is_mutant(h[i]);
+    if (!mutant)
+        return WaitForMultipleObjectsEx(count, h, all, ms, alertable);
+    for (;;) {
+        r = WaitForMultipleObjectsEx(count, h, all, 250, alertable);
+        if (r != WAIT_TIMEOUT)
+            return r;
+        if (s_wait_break != gen) {
+            fprintf(stderr, "[SYNC] stalled wait on %lu object(s) incl. mutant %p broken (thread %lu)\n",
+                    (unsigned long)count, h[0], (unsigned long)GetCurrentThreadId());
+            return WAIT_TIMEOUT;
+        }
+    }
+}
