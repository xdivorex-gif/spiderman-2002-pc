+static HANDLE s_mutants[512];
+static volatile LONG s_nmutants;
+static volatile LONG s_wait_break;
+
+void xbox_BreakStalledWaits(void)
+{
+    InterlockedIncrement(&s_wait_break);
+}
+
+static int is_mutant(HANDLE h)
+{
+    LONG i, n = s_nmutants;
+    for (i = 0; i < n && i < 512; i++)
+        if (s_mutants[i] == h)
+            return 1;
+    return 0;
